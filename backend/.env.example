
# Copiá este archivo como ".env" (en la carpeta backend) y completá los valores.
# ".env" NO se sube a git (ya está en .gitignore).

# Tu Postgres local, base "proyecto-kiosco".
# Si la contraseña tiene caracteres especiales (@ # / : ?), hay que codificarlos
# (ej: @ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/proyecto-kiosco

# En Render: pegá la "Internal Database URL" de tu Postgres como variable DATABASE_URL.

# Clave para firmar los tokens de sesión. Cualquier texto largo y random.
SECRET_KEY=cambiar-por-un-texto-largo-y-random

# Dominio del frontend para CORS. En desarrollo dejá "*"; en producción poné la URL real
# (ej: https://tu-sitio.onrender.com), sin barra final.
FRONTEND_ORIGIN=*

# Puerto local (Render lo define solo)
PORT=5000
